# --- Entorno ---
ENVIRONMENT=local              # local mientras pruebas / vps en produccion
PAPER_TRADING=true             # true = simula ordenes, false = capital real (requiere PRIVATE_KEY real)
PAPER_SESSION_MAX_HOURS=24      # tope duro de duracion de una sesion de paper trading
PAPER_SESSION_INTERVAL_MINUTES=30  # cada cuanto se evalua un "nuevo partido" simulado

# --- Polygon / Polymarket ---
PRIVATE_KEY=                     # NUNCA commitear. Hot wallet dedicada, solo capital operativo del dia.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137

# --- RPCs (orden = prioridad de failover) ---
RPC_URLS=https://polygon-mainnet.g.alchemy.com/v2/KEY,https://polygon-mainnet.infura.io/v3/KEY,https://rpc.ankr.com/polygon

# --- Cold storage (auto-sweep) ---
COLD_STORAGE_ADDRESS=
SWEEP_THRESHOLD_USDC=500
SWEEP_KEEP_USDC=100

# --- Datos deportivos ---
SPORTRADAR_API_KEY=
TENNIS_DATA_API_KEY=
PINNACLE_API_KEY=

# --- Binance / Bybit websockets (publico, no requiere key para market data) ---
BINANCE_WS_BASE=wss://stream.binance.com:9443
BYBIT_WS_BASE=wss://stream.bybit.com/v5/public/spot

# --- Chainlink feed (Polygon mainnet, BTC/USD) ---
CHAINLINK_BTC_USD_FEED=0xc907E116054Ad103354f2D350FD2514fB187B62

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Riesgo ---
DAILY_STOPLOSS_PCT=0.05
KELLY_FRACTION=0.25
MAX_SLIPPAGE_PCT=0.015
MAX_SPREAD_PCT=0.02
CANCEL_REPLACE_TIMEOUT_S=1.5

# --- Monitoreo ---
BETTERUPTIME_HEARTBEAT_URL=
HEARTBEAT_INTERVAL_S=60

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
